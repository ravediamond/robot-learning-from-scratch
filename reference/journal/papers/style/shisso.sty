% shisso.sty -- Shisso Robotics house style (WS-132). Light: one accent colour, a small mark, a footer line.
% Loads on top of article / neurips / icml / IEEEtran. Options: none. Set \shissorepo{} and \shissocommit{} before \begin{document}.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{shisso}[2026/11/02 Shisso Robotics house style]
\RequirePackage{xcolor}
\RequirePackage{iftex}
\definecolor{shissoaccent}{HTML}{1F5FBF}
\definecolor{shissogrey}{HTML}{555B66}
\definecolor{shissoshade}{HTML}{E8EEF8}
\newcommand{\shissorepo}[1]{\gdef\shisso@repo{#1}}
\newcommand{\shissocommit}[1]{\gdef\shisso@commit{#1}}
\shissorepo{github.com/ravediamond}
\shissocommit{}
\InputIfFileExists{shisso_commit.tex}{}{}% written by `make pdf` (git rev-parse --short HEAD); untracked, so main.tex stays byte-stable
\ifXeTeX
  \RequirePackage{fontspec}
  \setmainfont{texgyrepagella}[Extension=.otf,UprightFont=*-regular,BoldFont=*-bold,ItalicFont=*-italic,BoldItalicFont=*-bolditalic]
\else
  \RequirePackage[T1]{fontenc}
  \RequirePackage{mathpazo}
\fi
\RequirePackage{booktabs,colortbl,graphicx}
\RequirePackage{hyperref}
\hypersetup{colorlinks=true,linkcolor=shissoaccent,citecolor=shissoaccent,urlcolor=shissoaccent}
\RequirePackage{titlesec}
\RequirePackage{fancyhdr}
\RequirePackage{eso-pic}
\RequirePackage{tikz}
% section headings in the accent (classes keep their own sizes; only colour is added)
\titleformat*{\section}{\normalfont\large\bfseries\color{shissoaccent}}
\titleformat*{\subsection}{\normalfont\normalsize\bfseries\color{shissoaccent}}
% tables: accent rules, shaded header row via \shissohead
\arrayrulecolor{shissoaccent}
\renewcommand{\toprule}{\specialrule{\heavyrulewidth}{0pt}{0pt}}
\newcommand{\shissohead}{\rowcolor{shissoshade}}
% footer: repo URL, commit, page number on every page
\newcommand{\shisso@footer}{\footnotesize\color{shissogrey}\shisso@repo\ifx\shisso@commit\@empty\else\ $\cdot$ \texttt{\shisso@commit}\fi\hfill\thepage}
\pagestyle{fancy}\fancyhf{}\renewcommand{\headrulewidth}{0pt}
\fancyfoot[C]{\shisso@footer}
\fancypagestyle{plain}{\fancyhf{}\renewcommand{\headrulewidth}{0pt}\fancyfoot[C]{\shisso@footer}}
% logo, top-right of page 1 only (paper repos: paper/style/logo/; override with \renewcommand{\shissologo}{...})
\newcommand{\shissologo}{style/logo/shisso_wordmark.pdf}
\AddToShipoutPictureBG*{\ifnum\value{page}=1\AtPageUpperLeft{\put(\LenToUnit{\dimexpr\paperwidth-0.75in-3.2cm\relax},\LenToUnit{-0.5in}){\includegraphics[width=3.2cm]{\shissologo}}}\fi}
% title rule in the accent
\g@addto@macro\maketitle{\par\nointerlineskip{\color{shissoaccent}\hrule height 0.8pt}\vspace{4pt}}
